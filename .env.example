# ==============================================================================
# TIMELOOP AI – ENTERTAINMENT EDITION: ENVIRONMENT CONFIGURATION
# ==============================================================================

# NVIDIA NIM API (Primary LLM inference provider)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified model candidate: Mistral Large 4 (or mistralai/mistral-large-3-675b-instruct-2512 / meta/llama-3.1-70b-instruct)
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b

# SUPABASE (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# IMAGE PROVIDER (Optional external generator; falls back gracefully to preview artwork)
# NVIDIA Image endpoint or external image API
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=

# VOICE PROVIDER (Optional external TTS; default is high-fidelity browser SpeechSynthesis)
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=

# APP SECURITY & CONFIG
APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
